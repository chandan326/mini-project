# Set these in your shell/IDE or hosting environment; never commit real values.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Required for persistent production accounts and reports. Leave blank locally.
DATABASE_URL=
# Cloudinary requires all three values, or a CLOUDINARY_URL instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Explicit demo workflow: no disease inference.
DEMO_MODE=True
# For real inference: set DEMO_MODE=False and a working key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CONFIDENCE_THRESHOLD=0.60
CONSISTENCY_THRESHOLD=0.50
CSRF_TRUSTED_ORIGINS=
